#include <Arduino.h>
#include <WiFi.h>
#include <WebServer.h>

char ssid[]= "esp32_wifi";
char pwd[] = "abhirath";

WebServer server(80);

void handleRoot() {
    String html = "<html>\n"
              "<body>\n"
              "<h1>LED Control</h1>\n"
              "<a href=\"/on\"><button>ON</button></a>\n"
              "<a href=\"/off\"><button>OFF</button></a>\n"
              "</body>\n"
              "</html>";
  server.send(200, "text/html", html);
}
void handleon() {
  digitalWrite(2, HIGH);
  server.send(200, "text/plain", "LED is ON");
  server.sendHeader("Location", "/");
server.send(303);
}
void handleoff() {
  digitalWrite(2, LOW);
  server.send(200, "text/plain", "LED is OFF");
  server.sendHeader("Location", "/");
server.send(303);
}

void setup(){
    pinMode(2, OUTPUT);
    Serial.begin(115200);
    WiFi.mode(WIFI_AP) ;
    WiFi.softAP(ssid, pwd);
    Serial.println("Created Wifi netword");
    Serial.println("Wifi Name: esp32_wifi");
    Serial.println("IP Address: ");
    Serial.println(WiFi.softAPIP());
    server.on("/", handleRoot);
    server.on("/on", handleon);
    server.on("/off", handleoff);
    server.begin();


}
void loop(){
    server.handleClient();
}   
