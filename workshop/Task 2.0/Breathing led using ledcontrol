#include <Arduino.h>
int last = 0;
int brightness = 0;
int fade = 5;
void setup() {
 pinMode(2, OUTPUT);
 ledcAttach(2, 5000, 8);
}

void loop() {
  int time = millis();
  
  if(time-last<15) return;
  ledcWrite(2, brightness);
  if(brightness == 0) fade = 5;
  if(brightness == 255) fade = -5;
  brightness += fade;
  last = time;
}
